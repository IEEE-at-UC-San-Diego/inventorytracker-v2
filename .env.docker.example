# Paste these into Dokploy's Environment tab for the compose service.

# Public URLs you assign as Dokploy domains.
CONVEX_CLOUD_ORIGIN=https://convex.inventory.example.com      # -> backend:3210
CONVEX_SITE_ORIGIN=https://convex-site.inventory.example.com  # -> backend:3211

# Generate once with `openssl rand -hex 32` and keep it; the admin key is derived from it.
CONVEX_INSTANCE_SECRET=
CONVEX_INSTANCE_NAME=inventory-tracker

# Leave empty for the first deploy, then fill it in from
# `docker exec <backend container> ./generate_admin_key.sh` and redeploy.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Optional: Postgres/MySQL URL instead of the bundled SQLite volume.
CONVEX_DATABASE_URL=

# Logto SPA app (used by both the browser build and Convex token validation).
LOGTO_ENDPOINT=https://auth.ieeeatucsd.org
LOGTO_APP_ID=
