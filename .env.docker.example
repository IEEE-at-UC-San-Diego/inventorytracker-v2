# Paste these into Dokploy's Environment tab for the compose service.

# Public API URL of your self-hosted Convex (its port 3210), no trailing slash.
CONVEX_URL=https://convex.example.com

# Admin key for that instance (from ./generate_admin_key.sh in its container).
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Optional: a different URL for the deploy job to reach Convex, e.g. an internal
# address if both run on dokploy-network. Defaults to CONVEX_URL.
CONVEX_SELF_HOSTED_URL=

# Logto SPA app (used by both the browser build and Convex token validation).
LOGTO_ENDPOINT=https://auth.ieeeatucsd.org
LOGTO_APP_ID=
